{
  "name": "itu-e164-country-codes",
  "version": "2.0.0",
  "description": "Javascript Module for searching ITU-T E.164 Country Codes",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/build-esm.mjs",
    "prepare": "npm run build",
    "test": "npm run build && npm run test:jest && npm run test:types && npm run test:dist",
    "test:jest": "jest",
    "test:types": "check-dts",
    "test:dist": "node test/smoke.mjs",
    "coverage": "jest --coverage",
    "lint": "eslint \"**/*.{ts,mjs}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjdavey/itu-e164-country-codes.git"
  },
  "author": "Tristan Davey <tristan@tristandavey.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tjdavey/itu-e164-country-codes/issues"
  },
  "homepage": "https://github.com/tjdavey/itu-e164-country-codes#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "check-dts": "^0.7.2",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ITU-T",
    "ITU",
    "E.164",
    "164",
    "telephone",
    "telephony",
    "phone",
    "number",
    "dialing",
    "country",
    "code"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
